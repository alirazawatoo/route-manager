# Google Maps key with the Directions API enabled.
# Restrict it by IP (this is a server-side key) in the Google Cloud console.
GOOGLE_API_KEY=

# Seconds to wait for the Directions API before answering 504 (default 5).
GOOGLE_MAPS_TIMEOUT_SECONDS=5

# Optional: send Directions requests somewhere other than Google, e.g. a
# local stub that replays canned responses. Leave unset in production.
# GOOGLE_DIRECTIONS_URL=http://localhost:9000/maps/api/directions/json
